prototype(Neos.Neos:PrimaryContent).calendarEvent {
    @position = 'start'
    condition = ${q(documentNode).is('[instanceof UpAssist.Neos.Calendar:Event]')}
    renderer = UpAssist.Neos.Calendar:EventContent
}

# Renders the primary content of an Event document. The document itself keeps
# the site's page rendering: a prototype named after the document NodeType
# would replace the whole page.
prototype(UpAssist.Neos.Calendar:EventContent) < prototype(Neos.Fusion:Template) {
    templatePath = 'resource://UpAssist.Neos.Calendar/Private/Templates/DocumentTypes/Event.html'

    node = ${documentNode}
    title = ${q(documentNode).property('title')}
    startDateTime = ${q(documentNode).property('startDateTime')}
    endDateTime = ${q(documentNode).property('endDateTime')}
    location = ${q(documentNode).property('location')}

    main = Neos.Neos:ContentCollection {
        nodePath = 'main'
    }

    shareLinks = Neos.Fusion:DataStructure {
        @context.link = Neos.Neos:NodeUri {
            node = ${documentNode}
            absolute = true
        }

        attributes = 'class="calendar-share-links list-inline"'

        links = Neos.Fusion:DataStructure {
            twitter = Neos.Fusion:Tag {
                tagName = 'a'
                attributes.href = ${'https://twitter.com/home?status=' + link}
                content = '<i class="fa fa-twitter fa-lg"></i>'
            }

            facebook = Neos.Fusion:Tag {
                tagName = 'a'
                attributes.href = ${'https://www.facebook.com/sharer/sharer.php?u=' + link}
                content = '<i class="fa fa-facebook fa-lg"></i>'
            }

            googlePlus = Neos.Fusion:Tag {
                tagName = 'a'
                attributes.href = ${'https://plus.google.com/share?url=' + link}
                content = '<i class="fa fa-google-plus fa-lg"></i>'
            }

            linkedIn = Neos.Fusion:Tag {
                tagName = 'a'
                attributes.href = ${'https://www.linkedin.com/shareEvent?mini=true&url=' + link + '&title=&summary=&source='}
                content = '<i class="fa fa-linkedin fa-lg"></i>'
            }

            pinterest = Neos.Fusion:Tag {
                tagName = 'a'
                attributes.href = ${'https://pinterest.com/pin/create/button/?url=&media=' + link + '&description='}
                content = '<i class="fa fa-pinterest fa-lg"></i>'
            }

            email = Neos.Fusion:Tag {
                tagName = 'a'
                attributes.href = ${'mailto:?&subject=&body=' + link}
                content = '<i class="fa fa-paper-plane fa-lg"></i>'
            }
        }
    }
}
