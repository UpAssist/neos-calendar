# Render path for the "ics" format (see Configuration/Routes.yaml)
ics = Neos.Fusion:Case {
    event {
        condition = ${q(node).is('[instanceof UpAssist.Neos.Calendar:Event]')}
        type = 'UpAssist.Neos.Calendar:Ics'
    }
}

# Renders an Event document as an iCalendar file
prototype(UpAssist.Neos.Calendar:Ics) < prototype(Neos.Fusion:Http.Message) {
    httpResponseHead {
        headers.Content-Type = 'text/calendar;charset=utf-8'
    }
    content = UpAssist.Neos.Calendar:EventContent {
        templatePath = 'resource://UpAssist.Neos.Calendar/Private/Templates/ProtoTypes/Ics.html'
        organizer = ${Configuration.setting('UpAssist.Neos.Calendar.ics.organizer.name')}
        organizerEmail = ${Configuration.setting('UpAssist.Neos.Calendar.ics.organizer.email')}
        identifier = ${node.identifier}
    }
}
